# Example Vite env file for YouTube integration
# Copy this file to `.env.local` and fill in the real values.
# Do NOT commit your `.env.local` containing real API keys.

# YouTube Data API v3 key (server or client key). If you use this client-side,
# be aware the key will be visible in built bundles. Prefer a server-side proxy
# for production.
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# H3 channel ID (not the channel name). You can get this from the channel's
# About page or by inspecting the URL for the channel. Example: "UCxxxx..."
VITE_H3_CHANNEL_ID=UCXXXXXXXXXXXXXXX

# Optional: If you'd like to force a test video id locally, you can add:
# VITE_TEST_VIDEO_ID=0VUy5lRXk80
